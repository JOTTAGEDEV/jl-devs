  "narrative": {
    "northStar": "Liquid Glass / Apple minimalism",
    "overview": "White and silver provide a calm reading ground for near-black Inter typography. Translucent controls catch bright optical rims and diffuse shadows; brand green is transmitted through the primary action, active service tab and JL sculpture. This is the user-approved Apple minimalism / Liquid Glass world.\n\nThe supplied logo remains the identity anchor. Raster artwork supplies only the environmental glass and JL sculpture; navigation, headings, service controls and contact actions are semantic interface elements. The built source is normative for measurements; the approved comp establishes material and atmosphere.",
    "keyCharacteristics": [
      "Airy white and silver surfaces with clear dark text.",
      "Inter for display, body and controls.",
      "Green transmitted through optical glass, with restrained ambient depth.",
      "Responsive semantic controls and an optional animated scene."
    ],
    "rules": [
      {
        "name": "The Transmitted Green Rule",
        "body": "Concentrate bright brand green in glass actions, selected controls and brand artwork; use darker greens for readable small functional details.",
        "section": "colors"
      },
      {
        "name": "The Inter Rule",
        "body": "Use Inter for the shipped visual hierarchy, including display text. Imported Space Grotesk and JetBrains Mono are not active type roles.",
        "section": "typography"
      },
      {
        "name": "The Optical Rim Rule",
        "body": "Glass combines a translucent gradient, bright inset edges and a soft ambient shadow. Preserve the layered rim on primary actions and the selected service tab.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve Inter and the approved white, silver and green Liquid Glass material.",
      "Do keep functional text and controls in semantic code, with a visible focus outline.",
      "Do preserve both the reduced-motion path and the user pause control when extending animation.",
      "Do identify project compositions as illustrative until real, authorized captures are available.",
      "Do stack the service dock and content grids at the established mobile breakpoint."
    ],
    "donts": [
      "Don't restore the rejected dark green code-editor visual world.",
      "Don't turn illustrative project objects into evidence of an actual product interface, client result or metric.",
      "Don't promote the project letter glyph objects or removed eyebrow tags into reusable interface primitives.",
      "Don't place essential text or interactive controls inside the raster scene."
    ]
  }
}
