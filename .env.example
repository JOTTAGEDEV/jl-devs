# Opcional: domínio público para metadados de compartilhamento.
# Na Vercel, o domínio do projeto é detectado automaticamente.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Banco dos pedidos do checkout (Postgres/Neon). A Vercel preenche sozinha
# quando o banco é criado em Storage e ligado ao projeto.
# DATABASE_URL=postgres://usuario:senha@host/banco

# Acesso ao /painel. Sem PAINEL_SENHA o painel fica desligado.
# PAINEL_USUARIO=jl
# PAINEL_SENHA=escolha-uma-senha-forte
